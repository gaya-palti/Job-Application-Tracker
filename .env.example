# Firebase web app configuration.
# Copy this file to `.env.local` and fill in the values from your Firebase
# project settings (Project settings > General > Your apps > SDK setup).
# `.env.local` is git-ignored and must never be committed.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: set only if you use a named (non-default) Firestore database.
# Leave blank to use the project's default database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Gemini API key for AI auto-fill of job postings (https://aistudio.google.com/apikey).
# Only needed locally: on the AI Studio deployment the key is injected server-side.
GEMINI_API_KEY=
